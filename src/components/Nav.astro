---
import { site, nav, navCompleto, waLink, base } from '../data/site';
---

<header class="site-header">
  <div class="site-header__in">
    <a href="#inicio" class="brand" aria-label={`${site.nombreLargo} — inicio`}>
      <img class="brand__img" src={`${base}/img/logo-lartol-claro.svg`} alt={site.nombreLargo} width="1725" height="278" />
    </a>

    <nav class="nav" aria-label="Navegación principal">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <div class="header-cta">
      <a class="header-wa" href={waLink} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-1.7-.8-2.8-1.5-3.8-3.3-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3 1.8.8 2.5.8 3.4.7.5-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/><path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.8L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.1 8.1 0 0 1 3.8 12c0-4.5 3.7-8.2 8.2-8.2s8.2 3.7 8.2 8.2-3.7 8.2-8.2 8.2z"/></svg>
        WhatsApp
      </a>
      <a class="btn btn--primary btn--sm" href="#contacto">
        <span class="btn__full">Solicitar cotización</span>
        <span class="btn__short">Cotizar</span>
      </a>
      <button class="burger" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="scroll-progress" data-progress role="presentation"></div>
</header>

<div class="scrim" data-scrim aria-hidden="true"></div>

<div class="menu" id="menu-movil" data-menu aria-hidden="true">
  <div class="menu__in">
    <div class="menu__top">
      <span class="menu__brand"><img src={`${base}/img/logo-lartol-claro.svg`} alt={site.nombreLargo} width="1725" height="278" /></span>
      <button class="menu__close" type="button" aria-label="Cerrar menú" data-menu-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <nav class="menu__nav" aria-label="Navegación móvil">
      {navCompleto.map((n, i) => (
        <a href={n.href} data-menu-link>
          <span class="menu__idx">{String(i + 1).padStart(2, '0')}</span>
          {n.label}
        </a>
      ))}
    </nav>

    <div class="menu__foot">
      <a class="btn btn--primary btn--lg" href="#contacto" data-menu-link>Solicitar cotización</a>
      <div class="menu__contact">
        <a href={waLink} target="_blank" rel="noopener">WhatsApp · {site.telefono}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </div>
</div>

<script>
  const burger = document.querySelector('[data-burger]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-menu]') as HTMLElement | null;
  const closeBtn = document.querySelector('[data-menu-close]') as HTMLButtonElement | null;

  if (burger && menu) {
    const scrim = document.querySelector('[data-scrim]') as HTMLElement | null;

    const abrir = (estado: boolean) => {
      menu.classList.toggle('is-open', estado);
      scrim?.classList.toggle('is-open', estado);
      burger.classList.toggle('is-open', estado);
      document.documentElement.classList.toggle('menu-abierto', estado);
      burger.setAttribute('aria-expanded', String(estado));
      burger.setAttribute('aria-label', estado ? 'Cerrar menú' : 'Abrir menú');
      menu.setAttribute('aria-hidden', String(!estado));
      if (estado) closeBtn?.focus({ preventScroll: true });
    };

    burger.addEventListener('click', () => abrir(!menu.classList.contains('is-open')));
    closeBtn?.addEventListener('click', () => abrir(false));
    scrim?.addEventListener('click', () => abrir(false));

    menu.querySelectorAll('[data-menu-link]').forEach((a) =>
      a.addEventListener('click', () => abrir(false))
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) abrir(false);
    });

    // Si se agranda la ventana, cerrar el panel
    const mq = window.matchMedia('(min-width: 1081px)');
    mq.addEventListener('change', (e) => { if (e.matches) abrir(false); });
  }
</script>
